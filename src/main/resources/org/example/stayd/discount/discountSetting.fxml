<?xml version="1.0" encoding="UTF-8"?>

<?import java.lang.*?>
<?import java.util.*?>
<?import javafx.scene.*?>
<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<?import javafx.scene.text.Text?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.stayd.domain.discount.controller.DiscountController">
    <fx:include source="../common/header.fxml"/>
    <!-- 고정된 네브바 -->
    <fx:include source="../common/navbar.fxml" AnchorPane.topAnchor="130.0"/>

    <!-- Discount Date -->
    <VBox spacing="10" alignment="CENTER_LEFT" layoutX="464" layoutY="220">
        <Text text="할인 날짜"/>
        <DatePicker fx:id="discountDate" prefWidth="150.0"/>
    </VBox>

    <!-- Discount Start Time -->
    <VBox spacing="10" alignment="CENTER_LEFT" layoutX="464" layoutY="290">
        <Text text="시작 시간"/>
        <ComboBox fx:id="discountStartTime" promptText="시작 시간" prefWidth="150.0"/>
    </VBox>

    <!-- Discount End Time -->
    <VBox spacing="10" alignment="CENTER_LEFT" layoutX="464" layoutY="360">
        <Text text="종료 시간"/>
        <ComboBox fx:id="discountEndTime" promptText="종료 시간" prefWidth="150.0"/>
    </VBox>

    <!-- Discount Rate -->
    <VBox spacing="10" alignment="CENTER_LEFT" layoutX="464" layoutY="430">
        <Text text="할인율 (%)"/>
        <TextField fx:id="discountRate" promptText="0 ~ 100" maxWidth="150"/>
    </VBox>

    <!-- Save Buttons -->
    <VBox spacing="10" alignment="CENTER_LEFT" layoutX="464" layoutY="500">
        <Button text="적용" onAction="#saveDiscountSettings" prefWidth="150.0" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" style="-fx-background-color: #A8D6AA;" textFill="white">
            <font>
                <Font name="System Bold" size="13.0" />
            </font></Button>
    </VBox>
</AnchorPane>