<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<HBox alignment="CENTER" prefHeight="30" prefWidth="1024.0" spacing="10" style="-fx-background-color:white" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="org.example.stayd.common.NavbarController">
    <Button onAction="#goToCafeCreate" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefWidth="190" style="-fx-background-color: #A8D6AA; -fx-background-radius: 10;" text="카페 생성" textFill="WHITE">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>
    <Button onAction="#goToCafeModifyDelete" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefWidth="190" style="-fx-background-color: #A8D6AA; -fx-background-radius: 10;" text="카페 수정" textFill="WHITE">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>
    <Button onAction="#goToReservationStatus" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefWidth="190" style="-fx-background-color: #A8D6AA; -fx-background-radius: 10;" text="날짜별 현황" textFill="WHITE">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>
    <Button onAction="#goToReservationStatusDay" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefWidth="190" style="-fx-background-color: #A8D6AA; -fx-background-radius: 10;" text="요일별 현황" textFill="WHITE">
      <font>
         <Font name="System Bold" size="13.0" />
      </font></Button>
    <Button onAction="#goToDiscountSettings" onMouseEntered="#handleMouseEnter" onMouseExited="#handleMouseExit" prefWidth="190" style="-fx-background-color: #A8D6AA; -fx-background-radius: 10; " text="할인 설정" textFill="WHITE">
        <font>
            <Font name="System Bold" size="13.0" />
        </font></Button>
</HBox>
