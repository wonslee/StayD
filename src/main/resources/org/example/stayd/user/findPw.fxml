<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.stayd.domain.user.controller.FindPwController">

    <!-- 로고 이미지 -->
    <ImageView fitHeight="500" fitWidth="250.0" layoutX="380" layoutY="150" pickOnBounds="true" preserveRatio="true">
        <Image url="@/images/header/logo.png"/>
    </ImageView>

    <!-- ID 필드 -->
    <TextField fx:id="loginIdField" layoutX="330" layoutY="305" prefHeight="50.0" prefWidth="350" promptText="ID"
               style="-fx-background-radius: 10;"/>

    <!-- 이메일 필드 -->
    <TextField fx:id="emailField" layoutX="330" layoutY="370" prefHeight="50.0" prefWidth="350.0" promptText="EMAIL"
               style="-fx-background-radius: 10;"/>

    <!-- ID, 이메일 확인 라벨 -->
    <Label fx:id="validationLabel" layoutX="330" layoutY="425" textFill="red"/>

    <!-- PW찾기 버튼 -->
    <Button fx:id="sendCodeButton" layoutX="330" layoutY="450" onAction="#onSendCode" prefHeight="50.0"
            prefWidth="350.0" style="-fx-background-color: #4CAF4F; -fx-background-radius: 10;" text="비밀번호 찾기"
            textFill="WHITE">
        <font>
            <Font name="D2Coding Bold" size="20.0"/>
        </font>
    </Button>
</AnchorPane>
