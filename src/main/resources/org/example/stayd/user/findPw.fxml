    <fx:include source="../common/header.fxml" />

    <TextField fx:id="loginIdField" layoutX="440" layoutY="315" promptText="ID" />

    <TextField fx:id="emailField" layoutX="440" layoutY="345" promptText="EMAIL" />

    <Label fx:id="validationLabel" layoutX="440" layoutY="375" text="" textFill="red" />

    <Button fx:id="sendCodeButton" layoutX="476.0" layoutY="395.0" onAction="#onSendCode" style="-fx-background-color: #4CAF4F;" text="비밀번호 찾기" textFill="WHITE" />
</AnchorPane>
