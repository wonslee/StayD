<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<AnchorPane prefWidth="1024" prefHeight="768"
            style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/21.0.8"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.stayd.domain.user.controller.LoginController">

   <fx:include source="../common/header.fxml"/>

   <TextField  fx:id="loginIdField"
               layoutX="440" layoutY="315"
               promptText="ID"/>

   <PasswordField fx:id="passwordField"
                  layoutX="440" layoutY="345"
                  promptText="PASSWORD"/>

   <Label fx:id="messageLabel"
          layoutX="440" layoutY="375"
          textFill="red"/>

   <Button fx:id="loginButton"
           layoutX="494" layoutY="395"
           style="-fx-background-color: #4CAF4F;"
           text="로그인"
           textFill="WHITE"
           onAction="#onLogin"/>

   <Label fx:id="findIdLabel"
          layoutX="415" layoutY="430"
          text="아이디 찾기"
          style="-fx-text-fill: black; -fx-underline: true;"
          onMouseClicked="#onFindId"
          onMouseEntered="#onLinkHover"
          onMouseExited="#onLinkExit"/>

   <Label fx:id="findPwLabel"
          layoutX="485" layoutY="430"
          text="비밀번호 찾기"
          style="-fx-text-fill: black; -fx-underline: true;"
          onMouseClicked="#onFindPw"
          onMouseEntered="#onLinkHover"
          onMouseExited="#onLinkExit"/>

   <Label fx:id="signUpLabel"
          layoutX="565" layoutY="430"
          text="회원가입"
          style="-fx-text-fill: black; -fx-underline: true;"
          onMouseClicked="#goToSignup"
          onMouseEntered="#onLinkHover"
          onMouseExited="#onLinkExit"/>
</AnchorPane>
