<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.PasswordField?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.text.Font?>

<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: #FFFFFF;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.stayd.domain.user.controller.LoginController">

    <!-- 로고 이미지 -->
    <ImageView fitHeight="500" fitWidth="250.0" layoutX="380" layoutY="150" pickOnBounds="true" preserveRatio="true">
        <Image url="@/images/header/logo.png"/>
    </ImageView>

    <!-- ID 필드 -->
    <TextField fx:id="loginIdField" layoutX="330" layoutY="305" prefHeight="50.0" prefWidth="350" promptText="ID"
               style="-fx-background-radius: 10;"/>

    <!-- PW 필드 -->
    <PasswordField fx:id="passwordField" layoutX="330" layoutY="370" prefHeight="50.0" prefWidth="350.0"
                   promptText="PASSWORD" style="-fx-background-radius: 10;"/>

    <!-- 메시지 라벨 -->
    <Label fx:id="messageLabel" layoutX="330" layoutY="425" textFill="red"/>

    <!-- 로그인 버튼 -->
    <Button fx:id="loginButton" layoutX="330" layoutY="450" onAction="#onLogin" prefHeight="50.0" prefWidth="350.0"
            style="-fx-background-color: #4CAF4F; -fx-background-radius: 10;" text="로그인" textFill="WHITE">
        <font>
            <Font name="D2Coding Bold" size="20.0"/>
        </font>
    </Button>

    <!-- 아이디 찾기, 비밀번호 찾기, 회원가입 라벨 -->
    <HBox alignment="CENTER" layoutX="330" layoutY="520" prefWidth="350.0" spacing="20">
        <Label fx:id="findIdLabel" onMouseClicked="#onFindId" onMouseEntered="#onLinkHover" onMouseExited="#onLinkExit"
               style="-fx-text-fill: black; -fx-underline: true;" text="아이디 찾기"/>
        <Label fx:id="findPwLabel" onMouseClicked="#onFindPw" onMouseEntered="#onLinkHover" onMouseExited="#onLinkExit"
               style="-fx-text-fill: black; -fx-underline: true;" text="비밀번호 찾기"/>
        <Label fx:id="signUpLabel" onMouseClicked="#goToSignup" onMouseEntered="#onLinkHover"
               onMouseExited="#onLinkExit" style="-fx-text-fill: black; -fx-underline: true;" text="회원가입"/>
    </HBox>
</AnchorPane>
