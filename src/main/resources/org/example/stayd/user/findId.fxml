<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.image.ImageView?>
<?import javafx.scene.image.Image?>
<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.stayd.domain.user.controller.FindIdController">

    <!-- 로고 이미지 -->
    <ImageView fitHeight="500" fitWidth="250.0" layoutX="380" layoutY="215" pickOnBounds="true" preserveRatio="true">
        <Image url="@../../../../images/header/logo.png"/>
    </ImageView>

    <!-- 이메일 필드 -->
    <TextField fx:id="emailTextField" layoutX="330" layoutY="370" prefHeight="50.0" prefWidth="350.0" promptText="EMAIL"
               style="-fx-background-radius: 10;"/>

    <!-- 메시지 라벨 -->
    <Label fx:id="emailValidationLabel" layoutX="330" layoutY="425" textFill="red"/>

    <!-- ID찾기 버튼 -->
    <Button fx:id="findIdButton" layoutX="330" layoutY="450" onAction="#onFindId" prefHeight="50.0" prefWidth="350.0"
            style="-fx-background-color: #4CAF4F; -fx-background-radius: 10;" text="아이디 찾기" textFill="WHITE">
        <font>
            <Font name="D2Coding Bold" size="20.0"/>
        </font>
    </Button>
</AnchorPane>
