<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.AnchorPane?>

<?import javafx.scene.control.PasswordField?>
<AnchorPane maxHeight="-Infinity" maxWidth="-Infinity" minHeight="-Infinity" minWidth="-Infinity" prefHeight="768" prefWidth="1024" style="-fx-background-color: #FFFFFF;" xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1" fx:controller="org.example.stayd.domain.user.controller.SignupController">
    <children>
        <fx:include source="../common/header.fxml" />

        <TextField fx:id="loginIdTextField"
                   layoutX="432.0" layoutY="240.0"
                   promptText="ID" />
        <Label fx:id="idValidationLabel"
               layoutX="432" layoutY="270"
               textFill="red"
               text=""/>

        <TextField fx:id="emailTextField"
                   layoutX="432.0" layoutY="290.0"
                   promptText="EMAIL" />
        <Label fx:id="emailValidationLabel"
               layoutX="432" layoutY="320"
               textFill="red"
               text=""/>

        <PasswordField fx:id="passwordTextField"
                   layoutX="432.0" layoutY="340.0"
                   promptText="PASSWORD" />
        <Label fx:id="passwordValidationLabel"
               layoutX="432.0" layoutY="370.0"
               text="" textFill="red" />

        <PasswordField fx:id="passwordMatchTextField"
                   layoutX="432.0" layoutY="390.0"
                   promptText="PASSWORD CHECK" />
        <Label fx:id="passwordMatchValidationLabel"
               layoutX="432.0" layoutY="420.0"
               text="" textFill="red" />

        <Button fx:id="signUpButton"
                disable="true"
                layoutX="474.0" layoutY="440.0"
                style="-fx-background-color: #4CAF4F;"
                text="회원가입" textFill="WHITE"
                onAction="#onSignUp" />

    </children>
</AnchorPane>
