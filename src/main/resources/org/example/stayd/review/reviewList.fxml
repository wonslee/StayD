<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.*?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.*?>

<AnchorPane xmlns="http://javafx.com/javafx"
            xmlns:fx="http://javafx.com/fxml"
            fx:controller="org.example.stayd.domain.review.controller.ReviewListController"
            prefWidth="1024.0" prefHeight="768.0"
            style="-fx-background-color:white;">

    <!-- ── 헤더 ─────────────────────────────────────────────── -->
    <AnchorPane fx:id="headerPane" prefHeight="130.0" AnchorPane.topAnchor="0.0" prefWidth="1024.0">
        <ImageView fx:id="logoImage" layoutX="20.0" layoutY="25.0"
                   fitWidth="110.0" fitHeight="50.0" pickOnBounds="true" preserveRatio="true"/>
        <HBox spacing="20.0" layoutX="940.0" layoutY="25.0">
            <ImageView fx:id="notificationIcon" fitWidth="24.0" fitHeight="24.0"/>
            <ImageView fx:id="userIcon"         fitWidth="24.0" fitHeight="24.0"/>
        </HBox>
    </AnchorPane>

    <!-- ── 탭 메뉴 ───────────────────────────────────────────── -->
    <HBox fx:id="tabMenu" spacing="60.0" layoutX="150.0" layoutY="140.0">
        <Label text="상세" style="-fx-font-size:14px;"/>
        <Label text="예약" style="-fx-font-size:14px;"/>
        <Label text="리뷰" style="-fx-font-size:14px; -fx-underline:true; -fx-text-fill:#2bb673;"/>
    </HBox>

    <!-- ── 메인 컨텐츠 ──────────────────────────────────────── -->
    <VBox fx:id="contentBox" layoutX="150.0" layoutY="190.0"
          spacing="25.0" prefWidth="724.0">

        <!-- 대표 이미지 + 텍스트 -->
        <StackPane>
            <ImageView fx:id="placeImage" fitWidth="724.0" fitHeight="140.0"/>
            <Label text="스터디카페 사진"
                   StackPane.alignment="CENTER_LEFT"
                   style="-fx-font-size:24px; -fx-text-fill:white; -fx-font-weight:bold;">
                <padding>
                    <Insets top="20.0" right="20.0" bottom="20.0" left="20.0"/>
                </padding>
            </Label>
        </StackPane>

        <!-- 평균 평점 -->
        <HBox spacing="10.0" alignment="CENTER_LEFT">
            <Label text="리뷰" style="-fx-font-size:16px; -fx-font-weight:bold;"/>
            <Label fx:id="ratingAvgLabel" text="0.0"
                   style="-fx-font-size:36px; -fx-font-weight:bold;"/>
            <Label text="★" style="-fx-font-size:28px; -fx-text-fill:#f1c40f;"/>
            <Label fx:id="reviewCountLabel" text="리뷰 0개"
                   style="-fx-font-size:12px; -fx-text-fill:#7d7d7d;"/>
        </HBox>

        <!-- 리뷰 리스트 -->
        <ListView fx:id="reviewListView"
                  prefHeight="300.0"
                  maxHeight="300.0"
                  styleClass="review-list"
                  VBox.vgrow="NEVER"/>

        <!-- 페이지네이션 -->
        <Pagination fx:id="pagination" maxPageIndicatorCount="10" pageCount="1">
            <VBox.margin>
                <Insets top="10.0" right="0.0" bottom="0.0" left="0.0"/>
            </VBox.margin>
        </Pagination>
    </VBox>

</AnchorPane>
