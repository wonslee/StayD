<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.control.*?>
<?import javafx.scene.layout.*?>

<HBox xmlns="http://javafx.com/javafx"
      xmlns:fx="http://javafx.com/fxml"
      spacing="10" alignment="TOP_LEFT"
      style="-fx-padding:15 10 15 10;
             -fx-background-color:white;
             -fx-border-color:#e0e0e0;
             -fx-border-width:0 0 1 0;">

    <!-- 왼쪽: 리뷰 본문 영역 -->
    <VBox spacing="4" HBox.hgrow="ALWAYS">
        <Label fx:id="nameLabel"    style="-fx-font-weight:bold;"/>
        <Label fx:id="ratingLabel"  style="-fx-text-fill:#f1c40f;"/>
        <Label fx:id="contentLabel" wrapText="true" maxWidth="600"/>
        <Label fx:id="dateLabel"    style="-fx-font-size:10px; -fx-text-fill:#888888;"/>
    </VBox>

    <!-- 오른쪽: 삭제 버튼 -->
    <Button fx:id="deleteBtn"
            text="삭제"
            visible="false"
            style="-fx-background-color: transparent;
                   -fx-text-fill: red;
                   -fx-font-size: 11px;"
            alignment="CENTER_RIGHT"/>
</HBox>
