<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성자 : 이원석, 방대혁 -->

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.effect.DropShadow?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.paint.Color?>
<VBox xmlns:fx="http://javafx.com/fxml"
      fx:controller="org.example.stayd.domain.reservation.controller.ReservationDetailController"
      spacing="24" alignment="TOP_CENTER">
    <padding>
        <Insets top="40" left="40" right="40" bottom="40"/>
    </padding>

    <!-- 제목 -->
    <Label fx:id="titleLabel" style="-fx-font-size: 24px; -fx-font-weight: bold; -fx-text-fill: #4CAF4F;"
           text="예약 상세 정보"/>

    <!-- 예약 정보 카드 -->
    <VBox spacing="20"
          style="-fx-border-color: #E0E0E0; -fx-border-radius: 10; -fx-background-radius: 10; -fx-padding: 25;">

        <!-- 카페 정보 섹션 -->
        <VBox spacing="15">
            <Label text="카페 정보" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Separator/>

            <GridPane hgap="20" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                </columnConstraints>

                <Label text="카페명:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="cafeNameLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #4CAF4F;"/>

                <Label text="주소:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="cafeAddressLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="연락처:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="cafePhoneLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="시간당 요금:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="cafePriceLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"
                       style="-fx-text-fill: #009688;"/>
            </GridPane>
        </VBox>

        <!-- 예약 정보 섹션 -->
        <VBox spacing="15">
            <Label text="예약 정보" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Separator/>

            <GridPane hgap="20" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                </columnConstraints>

                <Label text="예약 번호:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="reservationIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #2196F3;"/>

                <Label text="예약자 ID:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="userIdLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="예약 일자:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="reservationDateLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"/>

                <Label text="이용 시간:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="usageTimeLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>

                <Label text="요일:" GridPane.rowIndex="2" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="dayOfWeekLabel" GridPane.rowIndex="2" GridPane.columnIndex="1"/>

                <Label text="예약 생성일:" GridPane.rowIndex="2" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="createdAtLabel" GridPane.rowIndex="2" GridPane.columnIndex="3"/>
            </GridPane>
        </VBox>

        <!-- 결제 정보 섹션 -->
        <VBox spacing="15">
            <Label text="결제 정보" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Separator/>

            <GridPane hgap="20" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                </columnConstraints>

                <Label text="원가:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="originalPriceLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"/>

                <Label text="할인 금액:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="discountPriceLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"
                       style="-fx-text-fill: #FF5722;"/>

                <Label text="최종 결제금액:" GridPane.rowIndex="1" GridPane.columnIndex="0"
                       style="-fx-font-weight: bold; -fx-font-size: 14px;"/>
                <Label fx:id="finalPriceLabel" GridPane.rowIndex="1" GridPane.columnIndex="1"
                       style="-fx-text-fill: #009688; -fx-font-size: 16px; -fx-font-weight: bold;"/>

                <Label text="예약 상태:" GridPane.rowIndex="1" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="canceledLabel" GridPane.rowIndex="1" GridPane.columnIndex="3"/>
            </GridPane>
        </VBox>

        <!-- 리뷰 정보 섹션 (있는 경우에만 표시) -->
        <VBox fx:id="reviewSection" spacing="15" visible="false" managed="false">
            <Label text="리뷰 정보" style="-fx-font-size: 18px; -fx-font-weight: bold; -fx-text-fill: #333333;"/>
            <Separator/>

            <GridPane hgap="20" vgap="12">
                <columnConstraints>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                    <ColumnConstraints minWidth="120" halignment="RIGHT"/>
                    <ColumnConstraints minWidth="200" halignment="LEFT"/>
                </columnConstraints>

                <Label text="별점:" GridPane.rowIndex="0" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="ratingLabel" GridPane.rowIndex="0" GridPane.columnIndex="1"
                       style="-fx-text-fill: #FFC107;"/>

                <Label text="리뷰 작성일:" GridPane.rowIndex="0" GridPane.columnIndex="2" style="-fx-font-weight: bold;"/>
                <Label fx:id="reviewCreatedAtLabel" GridPane.rowIndex="0" GridPane.columnIndex="3"/>

                <Label text="리뷰 내용:" GridPane.rowIndex="1" GridPane.columnIndex="0" style="-fx-font-weight: bold;"/>
                <Label fx:id="reviewContentLabel" GridPane.rowIndex="1" GridPane.columnIndex="1" GridPane.columnSpan="3"
                       wrapText="true"
                       style="-fx-background-color: #F5F5F5; -fx-padding: 10; -fx-background-radius: 5;"/>
            </GridPane>
        </VBox>
    </VBox>

    <!-- 버튼 영역 -->
    <HBox spacing="20" alignment="CENTER">
        <Button fx:id="backButton" text="목록으로" prefWidth="120" prefHeight="40"
                style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                onAction="#handleBack" textFill="#4caf4f" onMouseEntered="#onModifyButtonEnter"
                onMouseExited="#onModifyButtonExit">
            <effect>
                <DropShadow>
                    <color>
                        <Color opacity="0.2779456377029419"/>
                    </color>
                </DropShadow>
            </effect>
        </Button>
        <Button fx:id="cancelReservationButton" text="예약 취소" prefWidth="120" prefHeight="40"
                style="-fx-background-color: white; -fx-font-weight: bold; -fx-background-radius: 10;"
                onAction="#handleCancelReservation" textFill="#ff6b6b" onMouseEntered="#onDeleteButtonEnter"
                onMouseExited="#onDeleteButtonExit">
            <effect>
                <DropShadow>
                    <color>
                        <Color opacity="0.2779456377029419"/>
                    </color>
                </DropShadow>
            </effect>
        </Button>
    </HBox>

    <!-- 상태 메시지 -->
    <Label fx:id="statusLabel" wrapText="true" style="-fx-text-fill: #E91E63; -fx-font-weight: bold;"/>
</VBox>