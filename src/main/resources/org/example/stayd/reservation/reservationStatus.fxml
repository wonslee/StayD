<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<?import javafx.scene.text.Font?>
<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: white;" xmlns:fx="http://javafx.com/fxml/1" xmlns="http://javafx.com/javafx/24.0.1" fx:controller="org.example.stayd.domain.reservation.controller.ReservationStatusController">
    <!-- 고정된 헤더 -->
    <fx:include source="../common/header.fxml" />

    <!-- 고정된 네브바 -->
    <fx:include source="../common/navbar.fxml" AnchorPane.topAnchor="130.0" />

    <!-- 날짜 선택 -->
    <HBox spacing="10" alignment="CENTER" AnchorPane.topAnchor="170.0" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0">
        <DatePicker fx:id="datePicker" onAction="#loadReservationStatus"/>
    </HBox>

    <AnchorPane AnchorPane.topAnchor="210.0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0" AnchorPane.bottomAnchor="0" style="-fx-background-color: white;">
        <VBox spacing="20" style="-fx-background-color: white;">
            <!-- BarChart를 사용하여 예약 현황을 표시 -->
            <BarChart fx:id="reservationBarChart" prefWidth="1024" prefHeight="550" style="-fx-background-color: white;">
                <xAxis>
                    <CategoryAxis fx:id="xAxis" />
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="yAxis" />
                </yAxis>
            </BarChart>
        </VBox>
    </AnchorPane>
</AnchorPane>
