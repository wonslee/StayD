<?xml version="1.0" encoding="UTF-8"?>
<!-- 작성자 : 방대혁 -->

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<AnchorPane prefHeight="768" prefWidth="1024" style="-fx-background-color: white;"
            xmlns="http://javafx.com/javafx/24.0.1" xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="org.example.stayd.domain.reservation.controller.ReservationStatusDayController">
    <!-- 고정된 헤더 -->
    <fx:include source="../common/header.fxml"/>

    <!-- 고정된 네브바 -->
    <fx:include source="../common/navbar.fxml" AnchorPane.topAnchor="130.0"/>

    <!-- 요일 선택 -->
    <HBox alignment="CENTER" spacing="10" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0"
          AnchorPane.topAnchor="170.0">
        <ComboBox fx:id="dayOfWeekComboBox" onAction="#loadDayOfWeekReservationStatus"/>
    </HBox>

    <!-- 요일별 예약 현황 차트 -->
    <AnchorPane style="-fx-background-color: white;" AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0"
                AnchorPane.rightAnchor="0" AnchorPane.topAnchor="210.0">
        <VBox spacing="20" style="-fx-background-color: white;">
            <!-- BarChart를 사용하여 요일별 예약 현황을 표시 -->
            <BarChart fx:id="dayReservationBarChart" prefHeight="550" prefWidth="1024"
                      style="-fx-background-color: white;">
                <xAxis>
                    <CategoryAxis fx:id="dayOfWeekXAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="dayOfWeekYAxis"/>
                </yAxis>
            </BarChart>
        </VBox>
    </AnchorPane>
</AnchorPane>
