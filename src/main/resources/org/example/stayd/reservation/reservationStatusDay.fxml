<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.chart.BarChart?>
<?import javafx.scene.chart.CategoryAxis?>
<?import javafx.scene.chart.NumberAxis?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.DatePicker?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.layout.AnchorPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Text?>

<AnchorPane prefHeight="768" prefWidth="1024" xmlns:fx="http://javafx.com/fxml/1"
            xmlns="http://javafx.com/javafx/24.0.1"
            fx:controller="org.example.stayd.domain.reservation.controller.ReservationStatusDayController">
    <!-- 고정된 헤더 -->
    <fx:include source="../common/header.fxml"/>

    <!-- 고정된 네브바 -->
    <fx:include source="../common/navbar.fxml" AnchorPane.topAnchor="130.0"/>

    <!-- 요일 선택 -->
    <HBox alignment="CENTER" AnchorPane.leftAnchor="10.0" AnchorPane.rightAnchor="10.0" AnchorPane.topAnchor="170.0">
        <Text text="요일 선택: "/>
        <ComboBox fx:id="dayOfWeekComboBox"/>
        <Button onAction="#loadDayOfWeekReservationStatus" text="조회"/>
    </HBox>

    <!-- 요일별 예약 현황 차트 -->
    <ScrollPane AnchorPane.bottomAnchor="0" AnchorPane.leftAnchor="0" AnchorPane.rightAnchor="0"
                AnchorPane.topAnchor="210.0">
        <VBox spacing="20">
            <!-- BarChart를 사용하여 요일별 예약 현황을 표시 -->
            <BarChart fx:id="dayReservationBarChart" prefHeight="550" prefWidth="1000">
                <xAxis>
                    <CategoryAxis fx:id="dayOfWeekXAxis"/>
                </xAxis>
                <yAxis>
                    <NumberAxis fx:id="dayOfWeekYAxis"/>
                </yAxis>
            </BarChart>
        </VBox>
    </ScrollPane>
</AnchorPane>
